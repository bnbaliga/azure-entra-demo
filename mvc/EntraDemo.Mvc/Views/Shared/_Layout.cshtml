@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirstValue("name") ?? User.FindFirstValue("preferred_username") ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} – " : "")Entra ID Demo (MVC)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">Entra ID Demo <span class="muted">· MVC</span></a>
            <nav class="actions">
                @if (signedIn)
                {
                    <span class="muted">@displayName</span>
                    <form asp-controller="Account" asp-action="SignOut" method="post">
                        <button class="button secondary" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="button secondary" asp-controller="Account" asp-action="SignUp">Create account</a>
                    <a class="button" asp-controller="Account" asp-action="SignIn">Sign in</a>
                }
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
