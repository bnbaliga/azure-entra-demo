# Credentials for the tastytrade SANDBOX (paper) environment only.
# Get them from https://developer.tastytrade.com -> Sandbox -> OAuth applications.
# Never put your live-account credentials here.
TT_SANDBOX_SECRET=your-sandbox-oauth-client-secret
TT_SANDBOX_REFRESH=your-sandbox-refresh-token

# Optional: default account number (otherwise the first sandbox account is used)
TT_SANDBOX_ACCOUNT=
