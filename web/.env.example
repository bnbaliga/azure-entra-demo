# Copy to .env.local and fill in values from your Entra app registrations.

# Application (client) ID of the SPA app registration ("entra-demo-web").
VITE_ENTRA_CLIENT_ID=34d1bddb-5078-4b54-92f7-01b01c00fd11

# Authority to sign in against:
#   Entra External ID (customers, supports self-service sign-up):
#     https://<tenant-subdomain>.ciamlogin.com/
#   Workforce tenant (employees/guests, no self-service sign-up):
#     https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/0ee7098b-9582-41b8-9a59-201f5a77cb12

# The delegated scope exposed by the API app registration ("entra-demo-api").
VITE_API_SCOPE=api://34d1bddb-5078-4b54-92f7-01b01c00fd11/demoscope

# Where the .NET API is running.
VITE_API_BASE_URL=http://localhost:5016
